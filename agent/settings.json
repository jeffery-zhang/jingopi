{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "muryo",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "npmCommand": [
    "npm",
    "--registry",
    "https://registry.npmmirror.com"
  ],
  "enabledModels": [
    "muryo/muse-spark-1.3-contributor",
    "muryo/muse-spark-1.3-contributor-free",
    "muryo/gemini-3.8-flash-high",
    "muryo/deepseek-v4.1-flash",
    "antigravity/gemini-3.8-flash",
    "muryo/stealth/union-alpha"
  ],
  "subagents": {
    "defaultModel": "muryo/deepseek-v4.1-flash",
    "defaultProvider": "muryo",
    "defaultThinking": "high",
    "maxThinking": "max",
    "agentOverrides": {
      "scout": {
        "model": "muryo/gemini-3.8-flash-high",
        "thinking": "high",
        "fallbackModels": [
          "muryo/deepseek-v4.1-flash:high"
        ]
      },
      "researcher": {
        "model": "muryo/deepseek-v4.1-flash",
        "thinking": "high",
        "fallbackModels": [
          "muryo/gemini-3.8-flash-high:high"
        ]
      },
      "worker": {
        "model": "muryo/gemini-3.8-flash-high",
        "thinking": "high",
        "fallbackModels": [
          "muryo/deepseek-v4.1-flash:max"
        ]
      },
      "reviewer": {
        "model": "muryo/deepseek-v4.1-flash",
        "thinking": "max",
        "fallbackModels": [
          "muryo/stealth/union-alpha:max"
        ]
      },
      "oracle": {
        "model": "muryo/stealth/union-alpha",
        "thinking": "max",
        "fallbackModels": [
          "muryo/deepseek-v4.1-flash:max"
        ]
      },
      "delegate": {
        "model": "muryo/gemini-3.8-flash-high",
        "thinking": "high",
        "fallbackModels": [
          "muryo/deepseek-v4.1-flash:high"
        ]
      }
    }
  },
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-fff",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-chrome",
    "npm:pi-rtk-optimizer",
    "npm:@jingoz/pi-questionnaire",
    "npm:pi-tool-display",
    "npm:@victor-software-house/pi-curated-themes",
    "npm:pi-subagents",
    "npm:@jingoz/pi-image-input",
    "npm:pi-hermes-memory",
    "npm:pi-antigravity"
  ],
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 300000,
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "regular"
}