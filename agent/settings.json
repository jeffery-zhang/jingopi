{
  "lastChangelogVersion": "0.84.3",
  "defaultProvider": "muryo",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "npmCommand": ["npm", "--registry", "https://registry.npmmirror.com"],
  "enabledModels": ["muryo/*"],
  "subagents": {
    "defaultModel": "muryo/gpt-5.6-luna",
    "defaultProvider": "muryo",
    "defaultThinking": "high",
    "maxThinking": "high",
    "agentOverrides": {
      "scout": {
        "model": "muryo/gemini-3.7-flash-tiered",
        "thinking": "high",
        "fallbackModels": ["muryo/gpt-5.6-luna:xhigh"]
      },
      "researcher": {
        "model": "muryo/gpt-5.6-sol",
        "thinking": "medium",
        "fallbackModels": ["muryo/gpt-5.6-terra:max"]
      },
      "worker": {
        "model": "muryo/deepseek-v4-flash",
        "thinking": "max",
        "fallbackModels": ["muryo/gpt-5.6-luna:max"]
      },
      "reviewer": {
        "model": "muryo/gpt-5.6-sol",
        "thinking": "xhigh",
        "fallbackModels": ["muryo/gpt-5.6-terra:max"]
      },
      "oracle": {
        "model": "muryo/gpt-5.6-sol",
        "thinking": "xhigh",
        "fallbackModels": ["muryo/gpt-5.6-terra:max"]
      },
      "delegate": {
        "model": "muryo/gpt-5.6-luna",
        "thinking": "max",
        "fallbackModels": ["muryo/gemini-3.7-flash-tiered:high"]
      }
    }
  },
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-fff",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-chrome",
    "npm:pi-rtk-optimizer",
    "npm:@jingoz/pi-questionnaire",
    "npm:pi-tool-display",
    "npm:@victor-software-house/pi-curated-themes",
    "npm:pi-subagents"
  ],
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 300000,
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "regular"
}
