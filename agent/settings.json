{
  "lastChangelogVersion": "0.84.3",
  "defaultProvider": "muryo",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "npmCommand": [
    "npm",
    "--registry",
    "https://registry.npmmirror.com"
  ],
  "enabledModels": [
    "muryo/*"
  ],
  "theme": "dark",
  "packages": [
    "npm:pi-fff",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-chrome",
    "npm:pi-rtk-optimizer",
    "npm:@jingoz/pi-questionnaire",
    "npm:pi-tool-display"
  ],
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 300000,
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "regular"
}