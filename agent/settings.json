{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "muryo",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "npmCommand": [
    "npm",
    "--registry",
    "https://registry.npmmirror.com"
  ],
  "enabledModels": [
    "muryo/gpt-5.6-sol",
    "muryo/gpt-5.6-terra",
    "muryo/gpt-5.6-luna",
    "muryo/gpt-5.5",
    "muryo/deepseek-v4-flash",
    "muryo/deepseek-v4-flash-vision-exp",
    "muryo/muse-spark-1.3-contributor",
    "antigravity/gemini-3.8-flash"
  ],
  "subagents": {
    "defaultModel": "muryo/gpt-5.6-sol",
    "defaultProvider": "muryo",
    "defaultThinking": "medium",
    "maxThinking": "max",
    "agentOverrides": {
      "scout": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "high",
        "fallbackModels": [
          "muryo/gpt-5.6-luna:max"
        ]
      },
      "researcher": {
        "model": "muryo/gpt-5.6-sol",
        "thinking": "medium",
        "fallbackModels": [
          "muryo/gpt-5.6-terra:max"
        ]
      },
      "worker": {
        "model": "muryo/deepseek-v4-flash",
        "thinking": "max",
        "fallbackModels": [
          "antigravity/gemini-3.8-flash:high"
        ]
      },
      "reviewer": {
        "model": "muryo/gpt-5.6-sol",
        "thinking": "xhigh",
        "fallbackModels": [
          "muryo/gpt-5.6-terra:max"
        ]
      },
      "oracle": {
        "model": "muryo/gpt-5.6-sol",
        "thinking": "xhigh",
        "fallbackModels": [
          "muryo/gpt-5.6-terra:max"
        ]
      },
      "delegate": {
        "model": "antigravity/gemini-3.8-flash",
        "thinking": "high",
        "fallbackModels": [
          "muryo/gpt-5.6-luna:max"
        ]
      }
    }
  },
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-fff",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    "npm:pi-chrome",
    "npm:pi-rtk-optimizer",
    "npm:@jingoz/pi-questionnaire",
    "npm:pi-tool-display",
    "npm:@victor-software-house/pi-curated-themes",
    "npm:pi-subagents",
    "npm:@jingoz/pi-image-input",
    "npm:pi-hermes-memory",
    "npm:pi-antigravity"
  ],
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 300000,
  "terminal": {
    "showTerminalProgress": true
  },
  "tuiMode": "regular"
}